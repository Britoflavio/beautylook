# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Mercado Pago OAuth app (https://applications.mercadopago.com)
MP_APP_ID=
MP_CLIENT_SECRET=
# Webhook secret configured in the MP developer dashboard
MP_WEBHOOK_SECRET=

# 32-byte key (base64) used to encrypt MP tokens at rest (AES-256-GCM)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MP_ENCRYPTION_KEY=

# Resend (transactional email)
RESEND_API_KEY=
EMAIL_FROM="BeautyBook <onboarding@resend.dev>"

# Secret required by /api/cron/* routes (Authorization: Bearer <secret>)
CRON_SECRET=

# Dev-only: allows simulating an approved payment webhook without MP credentials
DEV_SIMULATE_WEBHOOK=
